# Copia este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
# En Vercel, estas mismas variables se configuran en:
#   Project Settings → Environment Variables

# Cadena de conexión de tu proyecto de Neon (Dashboard de Neon → Connection string).
# Formato: postgresql://usuario:password@host/basededatos?sslmode=require
DATABASE_URL=

# Cuando conectes el marcador en tiempo real (ver SPORTS_API en QuinielappClient.js),
# esta key SOLO se usa desde app/api/**/route.js (servidor) — nunca en el cliente.
API_FOOTBALL_KEY=

# --- Login con Google / Facebook (NextAuth) ---
# NEXTAUTH_SECRET: cualquier cadena larga aleatoria. Genera una con:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# NEXTAUTH_URL: en local es http://localhost:3000. En Vercel, la URL que te
# haya dado (ej. https://quinielapp-web-xxxx.vercel.app) — sin / al final.
NEXTAUTH_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers → tu app → Facebook Login → Settings
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
